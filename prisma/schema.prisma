datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Stock {
  id              Int      @id @default(autoincrement())
  ticker          String   @unique
  name            String?
  sector          String?
  generalNotes    String?  @map("notes")
  summary         String?
  lastSummaryAt   DateTime?
  extractionError String?
  currentPrice    Float?
  pbRatio         Float?
  lastPriceUpdated DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  files           File[]
  notes          Note[]
  claims          Claim[]
  relationships   Relationship[]
  decision        Decision?
}

model File {
  id           Int    @id @default(autoincrement())
  stockId      Int
  stock        Stock  @relation(fields: [stockId], references: [id], onDelete: Cascade)
  filename     String
  originalName String
  fileType     String
  fileSize     Int
  description  String?
  markdown     String?
  createdAt    DateTime @default(now())
}

model Note {
  id        Int      @id @default(autoincrement())
  stockId   Int
  stock     Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  title     String?
  content   String
  tag       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("Entry")
}

model Tweet {
  id          Int            @id @default(autoincrement())
  contentHash String         @unique
  content     String
  timestamp   DateTime?
  claimCount  Int            @default(0)
  isInvesting Boolean?
  processedAt DateTime       @default(now())
  claims      Claim[]
  concepts    TweetConcept[]
}

model Claim {
  id        Int      @id @default(autoincrement())
  stockId   Int
  stock     Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  tweetId   Int?
  tweet     Tweet?   @relation(fields: [tweetId], references: [id], onDelete: SetNull)
  text      String
  source    String?
  status     String   @default("unverified")
  evidence   String?
  extractionConfidence Int? @map("confidence") // 1-5 LLM self-rating during extraction (null = not rated)
  researchStatus  String  @default("pending") // "pending" | "researching" | "done" | "failed"
  researchedAt    DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Concept {
  id          Int            @id @default(autoincrement())
  name        String         @unique
  description String?
  category    String?
  createdAt   DateTime       @default(now())
  tweets      TweetConcept[]
}

model TweetConcept {
  id        Int     @id @default(autoincrement())
  tweetId   Int
  conceptId Int
  tweet     Tweet   @relation(fields: [tweetId], references: [id], onDelete: Cascade)
  concept   Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@unique([tweetId, conceptId])
}

model Relationship {
  id          Int      @id @default(autoincrement())
  stockId     Int
  stock       Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  type        String   // "competitor" | "partner" | "supplier" | "moat" | "policy" | "gap" | AI-discovered
  target      String   // free text — company name, concept, policy, person
  description String?  // AI-written explanation
  sources     String?  // citations — e.g. "[Tweet 2024-03-15], [Annual Report 2025 p.10]"
  sourceConfidence  String   @default("speculative") @map("confidence") // "confirmed" | "speculative" | "gap"
  section     String   @default("known") // "known" | "contrarian"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Decision {
  id        Int      @id @default(autoincrement())
  stockId   Int      @unique
  stock     Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  maturity  String   // "beginning" | "core" | "actionable"
  action    String?  // "buy" | "hold" | "sell" | null (only for actionable)
  reasoning String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CleanupTask {
  id        Int      @id @default(autoincrement())
  type      String   // "duplicate_claim" | "ticker_normalize"
  status    String   @default("pending") // "pending" | "approved" | "ignored" | "executed"
  summary   String   // human-readable description shown on /cleanup page
  detail    String   // JSON blob with affected record IDs and proposed action
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ApiCallLog {
  id          Int      @id @default(autoincrement())
  source      String   // "deepseek" | "brave" | "finnhub"
  purpose     String   // "pre_filter" | "claim_extraction" | "summarize" | "research_verdict" | "cleanup_scan" | "relationship" | "price_refresh"
  model       String?  // e.g. "deepseek-chat"
  inputChars  Int?     // approximate input size (chars)
  outputChars Int?     // approximate output size (chars)
  estimatedCost Float? // USD
  createdAt   DateTime @default(now())
}
