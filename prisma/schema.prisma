datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Stock {
  id             Int      @id @default(autoincrement())
  ticker         String   @unique
  name           String?
  sector         String?
  notes          String?
  summary        String?
  lastSummaryAt  DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  files          File[]
  entries        Entry[]
  claims         Claim[]
}

model File {
  id           Int    @id @default(autoincrement())
  stockId      Int
  stock        Stock  @relation(fields: [stockId], references: [id], onDelete: Cascade)
  filename     String
  originalName String
  fileType     String
  fileSize     Int
  description  String?
  markdown     String?
  createdAt    DateTime @default(now())
}

model Entry {
  id        Int    @id @default(autoincrement())
  stockId   Int
  stock     Stock  @relation(fields: [stockId], references: [id], onDelete: Cascade)
  title     String?
  content   String
  tag       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tweet {
  id          Int            @id @default(autoincrement())
  contentHash String         @unique
  content     String
  timestamp   DateTime?
  claimCount  Int            @default(0)
  processedAt DateTime       @default(now())
  claims      Claim[]
  concepts    TweetConcept[]
}

model Claim {
  id        Int      @id @default(autoincrement())
  stockId   Int
  stock     Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  tweetId   Int?
  tweet     Tweet?   @relation(fields: [tweetId], references: [id], onDelete: SetNull)
  text      String
  source    String?
  status    String   @default("unverified")
  evidence  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Concept {
  id          Int            @id @default(autoincrement())
  name        String         @unique
  description String?
  category    String?
  createdAt   DateTime       @default(now())
  tweets      TweetConcept[]
}

model TweetConcept {
  id        Int     @id @default(autoincrement())
  tweetId   Int
  conceptId Int
  tweet     Tweet   @relation(fields: [tweetId], references: [id], onDelete: Cascade)
  concept   Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@unique([tweetId, conceptId])
}
