datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Stock {
  id              Int      @id @default(autoincrement())
  ticker          String   @unique
  name            String?
  sector          String?
  generalNotes    String?  @map("notes")
  summary         String?
  lastSummaryAt   DateTime?
  extractionError String?
  chokepointDepth Int?     // 1-5: how essential is what this company controls? Set by AI summary.
  narrative     String?    // conversational knowledge base story — generated after summarization
  synthesis     String?    // executive brief — scannable 30-second summary of ALL sources
  lastSynthesisAt DateTime?
  currentPrice    Float?
  currency        String?  // "USD", "KRW", "EUR", "CNY", "CAD", "TWD", "JPY", "HKD" etc. null = USD
  priceUsd        Float?   // USD-normalized price for cross-stock comparison (computed during refresh)
  pbRatio         Float?
  peRatio         Float?
  week52High      Float?
  week52Low       Float?
  marketCap       Float?    // market capitalization (from Finnhub, in millions USD)
  lastPriceUpdated DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  files           File[]
  notes          Note[]
  claims          Claim[]
  relationships   Relationship[]
  annotations     Annotation[]
  questions       ResearchQuestion[]
  decision        Decision?
}

model File {
  id           Int    @id @default(autoincrement())
  stockId      Int
  stock        Stock  @relation(fields: [stockId], references: [id], onDelete: Cascade)
  filename     String
  originalName String
  fileType     String
  fileSize     Int
  description  String?
  markdown     String?
  createdAt    DateTime @default(now())
}

model Note {
  id        Int      @id @default(autoincrement())
  stockId   Int
  stock     Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  title     String?
  content   String
  tag       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("Entry")
}

model Tweet {
  id          Int            @id @default(autoincrement())
  contentHash String         @unique
  content     String
  timestamp   DateTime?
  claimCount  Int            @default(0)
  isInvesting Boolean?
  processedAt DateTime       @default(now())
  claims      Claim[]
  concepts    TweetConcept[]
}

model Claim {
  id        Int      @id @default(autoincrement())
  stockId   Int
  stock     Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  tweetId   Int?
  tweet     Tweet?   @relation(fields: [tweetId], references: [id], onDelete: SetNull)
  text      String
  source    String?
  status     String   @default("unverified")
  evidence   String?
  humanNote  String?  // human observations; does not affect AI-owned status
  extractionConfidence Int? @map("confidence") // 1-5 LLM self-rating during extraction (null = not rated)
  impactScore    Int?    // 1-5: chokepoint relevance — how important is this claim?
  insightType    String? // "chokepoint" | "dependency" | "pricing_power" | "moat_signal" | "risk_factor" | "general"
  researchStatus  String  @default("pending") // "pending" | "researching" | "done" | "failed"
  researchedAt    DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Concept {
  id          Int            @id @default(autoincrement())
  name        String         @unique
  description String?
  category    String?
  type        String         @default("tag") // "tag" (descriptive label) | "insight" (structural finding)
  createdAt   DateTime       @default(now())
  tweets      TweetConcept[]
}

model TweetConcept {
  id        Int     @id @default(autoincrement())
  tweetId   Int
  conceptId Int
  tweet     Tweet   @relation(fields: [tweetId], references: [id], onDelete: Cascade)
  concept   Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@unique([tweetId, conceptId])
}

model Relationship {
  id          Int      @id @default(autoincrement())
  stockId     Int
  stock       Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  type        String   // "competitor" | "partner" | "supplier" | "moat" | "policy" | "gap" | AI-discovered
  target      String   // free text — company name, concept, policy, person
  description String?  // AI-written explanation
  sources     String?  // citations — e.g. "[Tweet 2024-03-15], [Annual Report 2025 p.10]"
  sourceConfidence  String   @default("speculative") @map("confidence") // "confirmed" | "speculative" | "gap"
  section     String   @default("known") // "known" | "contrarian"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Decision {
  id        Int      @id @default(autoincrement())
  stockId   Int      @unique
  stock     Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  maturity  String   // "beginning" | "core" | "actionable"
  action    String?  // "buy" | "hold" | "sell" | null (only for actionable)
  reasoning String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CleanupTask {
  id        Int      @id @default(autoincrement())
  type      String   // "duplicate_claim" | "ticker_normalize"
  status    String   @default("pending") // "pending" | "approved" | "ignored" | "executed"
  summary   String   // human-readable description shown on /cleanup page
  detail    String   // JSON blob with affected record IDs and proposed action
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ApiCallLog {
  id          Int      @id @default(autoincrement())
  source      String   // "deepseek" | "brave" | "finnhub"
  purpose     String   // "pre_filter" | "claim_extraction" | "summarize" | "research_verdict" | "cleanup_scan" | "relationship" | "price_refresh"
  model       String?  // e.g. "deepseek-chat"
  inputChars  Int?     // approximate input size (chars)
  outputChars Int?     // approximate output size (chars)
  estimatedCost Float? // USD
  createdAt   DateTime @default(now())
}

model PipelineRun {
  id          Int      @id @default(autoincrement())
  stage       String   // "ingest" | "extract" | "triage" | "research" | "summarize" | "relationship" | "score"
  status      String   @default("started") // "started" | "completed" | "failed" | "skipped"
  stockTicker String?  // ticker this run relates to (for easy querying without joins)
  stockId     Int?     // FK to Stock
  claimId     Int?     // FK to Claim
  tweetId     Int?     // FK to Tweet

  // What happened
  input       String?  // JSON: key inputs before the run
  output      String?  // JSON: results, verdicts, decisions
  decision    String?  // Human-readable plain-English summary of what was decided

  // Meta
  cost        Float?
  error       String?
  startedAt   DateTime @default(now())
  completedAt DateTime?
}

model Annotation {
  id          Int       @id @default(autoincrement())
  stockId     Int
  stock       Stock     @relation(fields: [stockId], references: [id], onDelete: Cascade)
  section     String?   // null = freestyle reflection; "what"/"chokepoint"/"numbers"/"risk"/"bottom" for narrative-anchored
  text        String
  aiFlag      String?   // study-pal flag: e.g. "contradiction", "outdated"
  aiCheckedAt DateTime? // last time the study pass checked this reflection
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ResearchQuestion {
  id           Int      @id @default(autoincrement())
  stockId      Int
  stock        Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  question     String
  answer       String?
  source       String   @default("template") // "template" | "ai" | "user"
  category     String?  // "moat" | "supply_chain" | "financials" | "risk" | "catalyst" | "management" | "customers" | "manufacturing" | "ip" | "regulatory" | "labor" | "rd" | "capex" | "insiders" | "valuation" | "general"
  status       String   @default("open")     // "open" | "answered" | "skipped"
  priority     Int      @default(0)
  priorityLock Boolean  @default(false)      // true = user set manually, formula skips
  staleReason  String?  // set when new data contradicts answer
  staleAt      DateTime?
  answeredAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([stockId, status])
  @@index([stockId, priority])
}

// Persisted work queue — the single reactivity plane (ADR-0001).
// The orchestrator's 30s tick drains due rows; retries are bounded by `attempts`.
model PendingTask {
  id        Int      @id @default(autoincrement())
  kind      String   // "research" | "summarize" | "extract" | "narrative" | "decision"
  ticker    String?
  claimId   Int?
  source    String?  // "telegram" | "scheduler" | "manual" — who asked for this work
  status    String   @default("pending") // "pending" | "claimed" | "done" | "dead"
  attempts  Int      @default(0)
  dueAt     DateTime @default(now())
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind, status, dueAt])
  @@index([ticker])
}

// Persists per-job last-run timestamps so daily jobs survive process restarts.
model ScheduleState {
  key       String   @id // "price" | "auditor" | "editor" | "cleanup" | "decision" | "watchdogDeep" | "ops" | "ingest" | "staleResearch"
  lastRunAt DateTime
}

